{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PointDOM",
  "version": "0.6.4",
  "identifier": "dev.pointdom.desktop",
  "build": {
    "beforeBuildCommand": "pnpm desktop:assets",
    "beforeDevCommand": "pnpm desktop:assets",
    "frontendDist": "../dist/desktop-app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PointDOM",
        "width": 460,
        "height": 640,
        "minWidth": 400,
        "minHeight": 480,
        "url": "index.html"
      },
      {
        "label": "tasks",
        "title": "PointDOM tasks",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "index.html?view=tray",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../dist/extension/": "extension/",
      "../dist/native/pointdom": "bin/pointdom",
      "../dist/native/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 640, "height": 420 },
        "windowPosition": { "x": 200, "y": 160 },
        "appPosition": { "x": 170, "y": 214 },
        "applicationFolderPosition": { "x": 470, "y": 214 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pointdom"]
      }
    }
  }
}
