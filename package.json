{
  "name": "pointdom",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Browser annotations delivered to your coding client over MCP",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "cargo run --locked -p pointdom-cli -- serve",
    "cli": "cargo run --locked -p pointdom-cli --",
    "dev": "cargo run --locked -p pointdom-cli -- serve",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm native:check",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:pack": "node scripts/release-native.mjs",
    "release:verify": "node scripts/verify-native-release.mjs",
    "icons": "tsx scripts/generate-icons.mjs",
    "desktop:build": "pnpm build && node scripts/desktop/build.mjs && tauri build --no-bundle",
    "desktop:dev": "pnpm build && tauri dev",
    "desktop:pack": "pnpm build && node scripts/desktop/build.mjs && tauri build",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "native:check": "cargo fmt --all -- --check && cargo clippy --locked --workspace --all-targets -- -D warnings && cargo test --locked --workspace",
    "native:contracts": "tsx scripts/native-contracts.ts",
    "desktop:assets": "node scripts/desktop/assets.mjs"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@tauri-apps/api": "2.12.4",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/gravity-ui": "1.2.15",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@radix-ui/colors": "3.0.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itscyrus-dev/PointDOM.git"
  }
}
