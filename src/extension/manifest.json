{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "zh_CN",
  "version": "0.6.3",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:4318/*", "https://api.github.com/*"],
  "action": {
    "default_title": "__MSG_openPanel__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "panel.html?settings=1",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4318 https://api.github.com"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_pickElement__"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
