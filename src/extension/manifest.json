{
  "manifest_version": 3,
  "name": "PagePatch · 网页改代码",
  "version": "0.2.0",
  "description": "网页 DOM 批注：交给 Codex 或通过 MCP 连接其他编程 Agent。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:4318/*"],
  "action": {
    "default_title": "打开 PagePatch"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4318"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "选取网页元素"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  }
}
